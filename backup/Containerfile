FROM rust:1-alpine3.22 AS build

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --locked

FROM alpine:3.22
RUN apk add --no-cache ca-certificates rclone
COPY --from=build /app/target/release/keydungeon-backup-watcher /usr/local/bin/keydungeon-backup-watcher

ENTRYPOINT ["/usr/local/bin/keydungeon-backup-watcher"]
